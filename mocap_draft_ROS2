    def _watchdog_cb(self):
        now_ns = self.get_clock().now().nanoseconds

        connected = False
        if self.last_pose_time_ns is not None:
            dt_s = (now_ns - self.last_pose_time_ns) * 1e-9
            connected = (dt_s <= self.timeout_s)

        msg = Bool()
        msg.data = connected
        self.status_pub.publish(msg)

    def publish_pose_and_odom(self, x, y, z, qx, qy, qz, qw):
        now = self.get_clock().now()
        now_ns = now.nanoseconds
        self.last_pose_time_ns = now_ns

        # PoseStamped
        pose = PoseStamped()
        pose.header.stamp = now.to_msg()
        pose.header.frame_id = self.frame_id
        pose.pose.position.x = float(x)
        pose.pose.position.y = float(y)
        pose.pose.position.z = float(z)
        pose.pose.orientation.x = float(qx)
        pose.pose.orientation.y = float(qy)
        pose.pose.orientation.z = float(qz)
        pose.pose.orientation.w = float(qw)
        self.pose_pub.publish(pose)

        # Odometry with simple velocity estimate
        odom = Odometry()
        odom.header.stamp = pose.header.stamp
        odom.header.frame_id = self.frame_id
        odom.child_frame_id = self.child_frame_id
        odom.pose.pose = pose.pose

        vx = vy = vz = 0.0
        if self.prev_position is not None and self.prev_time_ns is not None:
            dt_s = (now_ns - self.prev_time_ns) * 1e-9
            if dt_s > 1e-6:
                vx = (float(x) - self.prev_position[0]) / dt_s
                vy = (float(y) - self.prev_position[1]) / dt_s
                vz = (float(z) - self.prev_position[2]) / dt_s

        odom.twist.twist.linear.x = vx
        odom.twist.twist.linear.y = vy
        odom.twist.twist.linear.z = vz
        self.odom_pub.publish(odom)

        self.prev_position = (float(x), float(y), float(z))
        self.prev_time_ns = now_ns

